$ORIGIN example.com.
$TTL 86400
@	SOA	dns1.example.com.	hostmaster.example.com. (
		2 ; serial
		21600      ; refresh after 6 hours
		3600       ; retry after 1 hour
		604800     ; expire after 1 week
		86400 )    ; minimum TTL of 1 day
;
	NS	dns1.example.com.
	NS	dns2.example.com.
	A	192.0.2.10
	AAAA	2001:db8::10
dns1	A	192.168.0.1
	AAAA	aaaa:bbbb::1
dns2	A	192.168.0.2
	AAAA	aaaa:bbbb::2
;
@	MX	10	mail.example.com.
	MX	20	mail1.example.com.
mail	A	192.168.0.3
	AAAA	aaaa:bbbb::3
mail1	A	192.168.0.4
	AAAA	aaaa:bbbb::4

tacos	A	192.168.0.5
		AAAA	aaaa:bbbb::5
		A	192.168.0.6
		AAAA	aaaa:bbbb::6
		A	192.168.0.7
		AAAA	aaaa:bbbb::7

dc1	CNAME	services.example.com.
dc2	CNAME	services.example.com.
services A	192.168.0.10
	AAAA	2001:db8::10

@	TXT	"nsd fuzzing zone"
chain1	CNAME	chain2.example.com.
chain2	CNAME	services.example.com.
longchain01	CNAME	longchain02.example.com.
longchain02	CNAME	longchain03.example.com.
longchain03	CNAME	longchain04.example.com.
